---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';
---

<Layout title="About — Espi Mariae" description="About Espi Mariae — handmade crochet and knitting.">
	<div class="about-page">
		<main class="about-page__card">
			<figure class="about-page__photo-wrap">
				<img
					class="about-page__photo"
					src={withBase('/images/about/espi.svg')}
					alt="Espi"
					width="280"
					height="280"
				/>
			</figure>

			<div class="about-page__text">
				<h1 class="about-page__greeting">Hello there</h1>
				<p>
					I am Espi and I have schyzophrenia and lots of diagnosis...
				</p>
				<p>
					For me, the world is very weird place full of darkness, but also I love how even magical
					the world is. So I am trying to transform world to a nicer place...
				</p>
			</div>
		</main>
	</div>
</Layout>

<style>
	.about-page {
		min-height: calc(100dvh - 4rem);
		padding: var(--space-md) var(--space-sm) var(--space-xl);
		max-width: 36rem;
		margin: 0 auto;
	}

	.about-page__card {
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		padding: var(--space-xl) var(--space-lg);
		box-shadow: var(--shadow-card);
		border: 1px solid var(--color-violet-pale);
		text-align: center;
	}

	.about-page__photo-wrap {
		margin: 0 auto var(--space-lg);
		width: min(100%, 280px);
	}

	.about-page__photo {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		border: 3px solid var(--color-violet-pale);
		box-shadow: var(--shadow-soft);
		object-fit: cover;
		aspect-ratio: 1;
	}

	.about-page__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.about-page__greeting {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 600;
		color: var(--color-text);
	}

	.about-page__text p {
		margin: 0;
		font-size: 1.0625rem;
		line-height: 1.75;
		color: var(--color-text-muted);
	}

	@media (max-width: 640px) {
		.about-page__card {
			padding: var(--space-lg) var(--space-md);
			border-radius: var(--radius-md);
		}
	}
</style>
