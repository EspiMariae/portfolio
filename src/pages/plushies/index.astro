---
import Layout from '../../layouts/Layout.astro';
import PlushieCategories from '../../components/PlushieCategories.astro';
---

<Layout title="Plushies — Espi Mariae" description="Handmade crochet and knitted plushies, shown in short video galleries.">
	<div class="plushies-page">
		<header class="plushies-page__header">
			<h1 class="plushies-page__title">Plushies</h1>
			<p class="plushies-page__intro">
				Choose a theme to explore handmade plushies. Each category opens eight short videos so
				you can see every piece up close.
			</p>
		</header>

		<PlushieCategories />
	</div>
</Layout>

<style>
	.plushies-page {
		min-height: calc(100dvh - 4rem);
		padding: var(--space-md) var(--space-sm) var(--space-xl);
		max-width: 72rem;
		margin: 0 auto;
	}

	.plushies-page__header {
		margin-bottom: var(--space-lg);
		text-align: center;
	}

	.plushies-page__title {
		margin: 0 0 var(--space-sm);
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 6vw, 3.25rem);
		font-weight: 600;
		color: var(--color-text);
	}

	.plushies-page__intro {
		margin: 0 auto;
		max-width: 46ch;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	@media (max-width: 640px) {
		.plushies-page {
			padding-bottom: var(--space-lg);
		}
	}
</style>
