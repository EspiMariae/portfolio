---
import { navItems } from '../data/navigation';
import { stripBase, withBase } from '../utils/paths';

const currentPath = stripBase(Astro.url.pathname);

function isActive(href: string): boolean {
	if (href === '/') return currentPath === '/';
	return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="nav">
	<div class="nav__inner">
		<a class="nav__brand" href={withBase('/')}>Espi Mariae</a>
		<nav class="nav__links" aria-label="Main navigation">
			{
				navItems.map((item) => (
					<a
						class:list={['nav__link', { 'nav__link--active': isActive(item.href) }]}
						href={withBase(item.href)}
						aria-current={isActive(item.href) ? 'page' : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		padding: var(--space-sm);
		background: rgba(250, 247, 252, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-violet-pale);
	}

	.nav__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 var(--space-xs);
	}

	.nav__brand {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--color-text);
		letter-spacing: -0.02em;
		white-space: nowrap;
	}

	.nav__brand:hover {
		color: var(--color-accent);
	}

	.nav__links {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.nav__link {
		padding: 0.5rem 1rem;
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
		color: var(--color-text-muted);
		border-radius: var(--radius-full);
		transition:
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.nav__link:hover {
		color: var(--color-accent);
		background: var(--color-violet-pale);
	}

	.nav__link--active {
		color: var(--color-accent);
		background: var(--color-violet-pale);
	}

	@media (max-width: 480px) {
		.nav__inner {
			flex-direction: column;
			align-items: center;
			gap: var(--space-sm);
		}

		.nav__links {
			justify-content: center;
		}
	}
</style>
