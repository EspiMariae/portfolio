---
import Layout from '../layouts/Layout.astro';

interface Props {
	title: string;
	description: string;
	intro: string;
}

const { title, description, intro } = Astro.props;
---

<Layout title={`${title} — Espi Mariae`} description={description}>
	<div class="content-page">
		<main class="content-page__card">
			<h1 class="content-page__title">{title}</h1>
			<p class="content-page__intro">{intro}</p>
			<div class="content-page__placeholder">
				<p>Nothing here yet. Check back soon.</p>
			</div>
		</main>
	</div>
</Layout>

<style>
	.content-page {
		min-height: calc(100dvh - 4rem);
		padding: var(--space-md) var(--space-sm) var(--space-xl);
		max-width: 40rem;
		margin: 0 auto;
	}

	.content-page__card {
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		padding: var(--space-xl) var(--space-lg);
		box-shadow: var(--shadow-card);
		border: 1px solid var(--color-violet-pale);
	}

	.content-page__title {
		margin: 0 0 var(--space-sm);
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 6vw, 3rem);
		font-weight: 600;
		color: var(--color-text);
	}

	.content-page__intro {
		margin: 0 0 var(--space-lg);
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	.content-page__placeholder {
		padding: var(--space-md);
		background: var(--color-bg-soft);
		border-radius: var(--radius-md);
		border: 1px dashed var(--color-violet-soft);
		text-align: center;
	}

	.content-page__placeholder p {
		margin: 0;
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		font-style: italic;
	}

	@media (max-width: 640px) {
		.content-page__card {
			padding: var(--space-lg) var(--space-md);
			border-radius: var(--radius-md);
		}
	}
</style>
